# Copy to .env and replace every value (each `openssl rand -hex 24` is fine).
# .env is git-ignored; it holds this stack's only secrets.
POSTGRES_PASSWORD=change-me
REDIS_AUTH=change-me
API_KEY=change-me
DEX_CLIENT_SECRET=change-me

# Worker size: WORKER_CORES caps parallel fits and Stan chains and must not
# exceed WORKER_CPUS. WORKER_MEMORY is the container memory limit the worker
# plans its parallel fits against.
WORKER_CORES=4
WORKER_CPUS=4
WORKER_MEMORY=8g
